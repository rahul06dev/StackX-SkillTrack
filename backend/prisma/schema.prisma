// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================
// PROJECT
// =============================

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById       String?
  assignedFacultyId String?

  status ProjectStatus @default(ACTIVE)

  createdBy       User? @relation("CreatedProjects", fields: [createdById], references: [id])
  assignedFaculty User? @relation("FacultyProjects", fields: [assignedFacultyId], references: [id])

  students ProjectStudent[]
  admins   ProjectAdmin[]

  columns Column[]

  projectSkills ProjectSkill[]
  skillEvidence StudentSkillEvidence[]
  activities    Activity[]
  invitations   ProjectInvitation[]

  tasksCount   Int @default(0)
  membersCount Int @default(0)

  @@index([createdById])
  @@index([assignedFacultyId])
  @@index([status])
}

model ProjectStudent {
  id        String   @id @default(uuid())
  projectId String
  studentId String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([projectId])
  @@index([studentId])
}

model ProjectAdmin {
  id        String   @id @default(uuid())
  projectId String
  adminId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  admin   User    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([projectId, adminId])
  @@index([projectId])
  @@index([adminId])
}

// =============================
// PROJECT INVITATIONS & COLLABORATION
// =============================

enum InvitationType {
  TEAM_MEMBER
  FACULTY_GUIDE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model ProjectInvitation {
  id          String           @id @default(uuid())
  projectId   String
  invitedById String
  recipientId String
  type        InvitationType
  status      InvitationStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  recipient User    @relation("ReceivedInvitations", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([invitedById])
  @@index([recipientId])
  @@index([status])
  @@index([recipientId, status])
  @@index([projectId, recipientId, status])
}

// =============================
// PROJECT STATUS
// =============================

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

// =============================
// COLUMN
// =============================

model Column {
  id         String   @id @default(uuid())
  projectId  String
  title      String
  colorClass String
  order      Int
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@index([projectId])
}

// =============================
// TASK
// =============================

model Task {
  id          String       @id @default(uuid())
  columnId    String
  title       String
  description String?
  priority    String
  dueDate     DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  column      Column       @relation(fields: [columnId], references: [id])
  comments    Comment[]
  attachments Attachment[]

  @@index([columnId])
  @@index([order])
  @@index([dueDate])
  @@index([columnId, order])
}

// =============================
// ATTACHMENT
// =============================

model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  fileName     String
  fileSize     Int
  mimeType     String
  filePath     String
  uploadedBy   String?
  uploaderName String?
  createdAt    DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// =============================
// ACTIVITY LOG
// =============================

model Activity {
  id        String   @id @default(uuid())
  projectId String
  taskId    String?
  userId    String?
  userName  String
  action    String
  details   String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
  @@index([projectId, createdAt])
}

// =============================
// COMMENT
// =============================

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  userName  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// =============================
// USER ROLE
// =============================

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

// =============================
// USER
// =============================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // Student Profile & Academic Passport Fields (Phase 4)
  headline       String?
  bio            String?             @db.Text
  department     String?
  studentIdNo    String?
  graduationYear String?
  githubUrl      String?
  linkedinUrl    String?
  shareableSlug  String?             @unique

  createdProjects Project[]        @relation("CreatedProjects")
  facultyProjects Project[]        @relation("FacultyProjects")
  studentProjects ProjectStudent[]
  adminProjects   ProjectAdmin[]

  sentInvitations     ProjectInvitation[] @relation("SentInvitations")
  receivedInvitations ProjectInvitation[] @relation("ReceivedInvitations")

  notifications Notification[] @relation("UserNotifications")

  studentSkills  StudentSkill[] @relation("StudentSkills")
  verifiedSkills StudentSkill[] @relation("VerifiedSkills")

  @@index([role])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectSkills ProjectSkill[]
  studentSkills StudentSkill[]
  jobRoleSkills JobRoleSkill[]
}

model ProjectSkill {
  id        String   @id @default(uuid())
  projectId String
  skillId   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
  @@index([projectId])
  @@index([skillId])
}

model StudentSkill {
  id              String                  @id @default(uuid())
  studentId       String
  skillId         String
  level           SkillLevel              @default(BEGINNER)
  verification    SkillVerificationStatus @default(PENDING)
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?                 @db.Text
  feedback        String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  student    User  @relation("StudentSkills", fields: [studentId], references: [id], onDelete: Cascade)
  skill      Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VerifiedSkills", fields: [verifiedById], references: [id], onDelete: SetNull)

  evidence StudentSkillEvidence[]

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([skillId])
  @@index([verification])
  @@index([verifiedById])
  @@index([studentId, verification])
}

model StudentSkillEvidence {
  id             String   @id @default(uuid())
  studentSkillId String
  projectId      String
  createdAt      DateTime @default(now())

  studentSkill StudentSkill @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([studentSkillId, projectId])
  @@index([studentSkillId])
  @@index([projectId])
}

// =============================
// JOB ROLES & REQUIRED SKILLS
// =============================

model JobRole {
  id          String   @id @default(uuid())
  title       String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requiredSkills JobRoleSkill[]

  @@index([isActive])
}

model JobRoleSkill {
  id        String   @id @default(uuid())
  jobRoleId String
  skillId   String
  createdAt DateTime @default(now())

  jobRole JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobRoleId, skillId])
  @@index([jobRoleId])
  @@index([skillId])
}

// =============================
// NOTIFICATIONS & COLLABORATION (Phase 7)
// =============================

enum NotificationType {
  PROJECT_INVITATION
  FACULTY_SUPERVISION_REQUEST
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  TASK_ASSIGNED
  DEADLINE_REMINDER
  SKILL_VERIFIED
  SKILL_REJECTED
  SYSTEM_ALERT
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}
